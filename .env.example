# Order API
DATABASE_URL=postgres://outbox:outbox@localhost:5432/outbox_poc
ADMIN_TOKEN=s3cret
# Signs the access tokens (HS256): a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret
# JWT_EXPIRES_IN=1h
# OUTBOX_RELAY=off  # API-only instance: adds messages, never publishes them
# WORKFLOW_WORKER=off  # API-only instance: starts and signals workflows, never runs them
KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=orders-api
# HEALTH_SHUTDOWN_DELAY_MS=5000  # on SIGTERM, /health/ready answers 503 this long before closing

# Analytics service
ANALYTICS_DATABASE_URL=postgres://outbox:outbox@localhost:5432/analytics

# NestJS Observe (APM)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
