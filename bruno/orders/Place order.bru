meta {
  name: Place order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

body:json {
  {
    "userId": "user-42",
    "items": [
      { "productId": "{{productId}}", "quantity": 2 }
    ]
  }
}

script:post-response {
  // Later requests (cancel, fulfilment) use the order just placed.
  if (res.body && res.body.id) {
    bru.setEnvVar("orderId", res.body.id);
  }
}

tests {
  test("returns 201 with a placed order", function () {
    expect(res.status).to.equal(201);
    expect(res.body.status).to.equal("placed");
  });
}
