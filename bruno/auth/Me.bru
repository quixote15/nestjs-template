meta {
  name: Me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 200 with the authenticated user", function () {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal(bru.getEnvVar("email"));
  });
}
