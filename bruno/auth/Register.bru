meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("returns 201, or 409 when the email is already registered", function () {
    expect([201, 409]).to.include(res.status);
  });
}
